<Application x:Class="OpenDBDiff.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OpenDBDiff.Wpf.Converters"
             xmlns:viewModels="clr-namespace:OpenDBDiff.Wpf.ViewModels"
             xmlns:views="clr-namespace:OpenDBDiff.Wpf.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <!-- The previous layout's styles, still used by the panels it contributed: the
                     connection panels and the options, error and data compare dialogs. -->
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <!-- Phase 2's styles: the connection strip, chip, environment tag, menu bar and toast.
                     Merged last so it can build on the tokens and the previous styles. -->
                <ResourceDictionary Source="Themes/Strip.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The redesign's converters, available to every view in it. -->
            <converters:StatusBrushConverter x:Key="StatusBrush" />
            <converters:StatusBadgeConverter x:Key="StatusBadge" />
            <converters:DiffLineBrushConverter x:Key="DiffLineBrush" />
            <converters:ExpandedGlyphConverter x:Key="ExpandedGlyph" />
            <converters:SelectionBrushConverter x:Key="SelectionBrush" />
            <converters:GroupedViewIndexConverter x:Key="GroupedIndex" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
            <converters:HexBrushConverter x:Key="HexBrush" />
            <converters:ValidityDotConverter x:Key="ValidityDot" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- View model to view mapping, so no code names a view for a dialog. -->
            <DataTemplate DataType="{x:Type viewModels:OptionsViewModel}">
                <views:OptionsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ErrorViewModel}">
                <views:ErrorView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:DataCompareViewModel}">
                <views:DataCompareView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ConfirmationViewModel}">
                <views:ConfirmationView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ScriptPreviewViewModel}">
                <views:ScriptPreviewView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:TextPromptViewModel}">
                <views:TextPromptView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ShortcutsViewModel}">
                <views:ShortcutsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
