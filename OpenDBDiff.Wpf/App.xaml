<Application x:Class="OpenDBDiff.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:OpenDBDiff.Wpf.ViewModels"
             xmlns:views="clr-namespace:OpenDBDiff.Wpf.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              View model to view mapping. The dialog shell looks its content up here, so no code
              anywhere names a view for a dialog.
            -->
            <DataTemplate DataType="{x:Type viewModels:ProgressViewModel}">
                <views:ProgressView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:OptionsViewModel}">
                <views:OptionsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ErrorViewModel}">
                <views:ErrorView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:DataCompareViewModel}">
                <views:DataCompareView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
