<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Phase 2's styles: the connection strip and its chip (section 6.1), the environment tag (6.1.4),
      the progress bar (6.2), the stale banner (9.6), the connection panel (6.1.1) and toasts (6.10).

      Merged after Tokens.xaml and Theme.xaml so it can build on both. Adding a style here rather than
      to Theme.xaml keeps the previous layout's styles untouched.
    -->

    <!-- Section 13.3: popovers and dialogs carry a shadow; panels only a 1 px border. -->
    <DropShadowEffect x:Key="PopoverShadow" Color="#141A28" BlurRadius="24" ShadowDepth="8"
                      Direction="270" Opacity="0.18" />

    <Style x:Key="AppNameLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Region A itself: 61 px, one border along the bottom (section 5.2). -->
    <Style x:Key="StripBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="MinHeight" Value="61" />
    </Style>

    <!-- Section 6.1.2: the chip. The whole chip is a button that opens the panel on its side. -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ChipBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipServerText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ChipDatabaseText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="5,0,0,0" />
    </Style>

    <!-- Section 6.1.2: the 8 px status dot. -->
    <Style x:Key="ChipDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Section 6.1.4: the environment tag, 18 high, 7 padding, radius 4, 11 bold upper case. -->
    <Style x:Key="EnvTagBorder" TargetType="Border">
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style x:Key="EnvTagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Section 6.1 items 3 and 8: the 40 x 36 icon buttons (swap, options, recent, collapsed menu). -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="IconChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconChrome" Property="Background" Value="{StaticResource HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconToggleButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="IconChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconChrome" Property="Background" Value="{StaticResource HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="IconChrome" Property="Background" Value="{StaticResource AccentBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section 6.1.5: the Schema / Data segmented control, and the detail pane's mode switch. -->
    <Style x:Key="SegmentedItem" TargetType="RadioButton">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Segment"
                            Background="Transparent"
                            BorderBrush="{StaticResource BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{StaticResource AccentBg}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentFg}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource AccentFg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A text button: Edit, Cancel, Retry, Accept (sections 6.1, 6.2, 6.1.4). -->
    <Style x:Key="TextLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AccentFg}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               TextDecorations="Underline" VerticalAlignment="Center" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section 6.2: the 3 px track. The fill shows while COMPARING or APPLYING, the track always. -->
    <Style x:Key="StripProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="{StaticResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="ProgressTrack" TargetType="Border">
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="{StaticResource BorderSubtle}" />
    </Style>

    <Style x:Key="ProgressFill" TargetType="Border">
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Section 6.1.1: the inline cards and the popover below the strip. -->
    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="PanelPopover" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Effect" Value="{StaticResource PopoverShadow}" />
    </Style>

    <Style x:Key="PanelFooterBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="0,0,8,8" />
    </Style>

    <!-- Section 6.1.1 item 5: the inline database-list error with its Retry link. -->
    <Style x:Key="InlineErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,6" />
    </Style>

    <!-- Section 9.6: the banner under the Summary Bar. -->
    <Style x:Key="StaleBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarningBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style x:Key="StaleBannerText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WarningFg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Section 6.10: toasts, bottom-centre above the Action Bar. -->
    <Style x:Key="ToastBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Text}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Effect" Value="{StaticResource PopoverShadow}" />
    </Style>

    <Style x:Key="ToastText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ToastErrorBorder" TargetType="Border" BasedOn="{StaticResource ToastBorder}">
        <Setter Property="Background" Value="{StaticResource Danger}" />
    </Style>

    <!-- A row inside a popover (the Recent comparisons menu, section 6.1.6). -->
    <Style x:Key="PopoverItemButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource HoverBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
