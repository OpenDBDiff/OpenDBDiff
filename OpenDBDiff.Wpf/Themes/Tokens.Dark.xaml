<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Section 13.4's dark token set: the same keys as Tokens.xaml, the same styles and the same
         typography, with every colour mapped to its dark equivalent. Generated from Tokens.xaml and
         checked by DarkThemeTests, which fails if the two dictionaries ever define different keys - the
         duplication is deliberate, because section 13.4 needs the swap to happen by replacing one
         merged dictionary rather than by re-resolving every static reference in the views. -->

<SolidColorBrush x:Key="Bg" Color="#12161C" />
    <SolidColorBrush x:Key="Surface" Color="#1B2028" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#232A34" />
    <SolidColorBrush x:Key="BorderSubtle" Color="#2E3742" />
    <SolidColorBrush x:Key="BorderStrong" Color="#3B4654" />
    <SolidColorBrush x:Key="Text" Color="#E7EAF0" />
    <SolidColorBrush x:Key="TextMuted" Color="#A2ACBA" />
    <SolidColorBrush x:Key="TextFaint" Color="#8792A2" />
    <SolidColorBrush x:Key="Accent" Color="#6E9BFF" />
    <SolidColorBrush x:Key="AccentBg" Color="#1E2A45" />
    <SolidColorBrush x:Key="AccentFg" Color="#A8C2FF" />
    <SolidColorBrush x:Key="SelectionBg" Color="#22314B" />
    <SolidColorBrush x:Key="WarningBg" Color="#3A2E12" />
    <SolidColorBrush x:Key="WarningFg" Color="#F5CE86" />
    <SolidColorBrush x:Key="Danger" Color="#C7363B" />
    <SolidColorBrush x:Key="Highlight" Color="#6B5A16" />
    <SolidColorBrush x:Key="HoverBg" Color="#232A34" />

    <SolidColorBrush x:Key="StatusCreateBg" Color="#1D3A2C" />
    <SolidColorBrush x:Key="StatusCreateFg" Color="#7FE3AE" />
    <SolidColorBrush x:Key="StatusCreateBorder" Color="#2F6B4E" />
    <SolidColorBrush x:Key="StatusAlterBg" Color="#1E2A4A" />
    <SolidColorBrush x:Key="StatusAlterFg" Color="#A8C2FF" />
    <SolidColorBrush x:Key="StatusAlterBorder" Color="#3A5390" />
    <SolidColorBrush x:Key="StatusDropBg" Color="#3A1F1D" />
    <SolidColorBrush x:Key="StatusDropFg" Color="#FFA79C" />

    <!-- Section 6.5.3: the run of a line that word-level diffing marked as changed, drawn inside the
         line's own tint so a one-word edit does not look like a rewritten line. The text on these is
         the normal text colour and clears AA comfortably on all three. -->
    <SolidColorBrush x:Key="WordAddedBg" Color="#5941A86A" />
    <SolidColorBrush x:Key="WordRemovedBg" Color="#59E86A5F" />
    <SolidColorBrush x:Key="WordChangedBg" Color="#59B98A2E" />

    <!-- Environment tag (section 6.1.4): Dev green, Test blue, UAT purple, Prod amber, custom grey.
         The model owns these values (EnvironmentPalette) and the tag draws them through HexBrush, so
         these keys exist for the places that cannot reach a view model. -->
    <SolidColorBrush x:Key="EnvDevBg" Color="#1D3A2C" />
    <SolidColorBrush x:Key="EnvDevFg" Color="#7FE3AE" />
    <SolidColorBrush x:Key="EnvTestBg" Color="#1E2A45" />
    <SolidColorBrush x:Key="EnvTestFg" Color="#A8C2FF" />
    <SolidColorBrush x:Key="EnvUatBg" Color="#2C2340" />
    <SolidColorBrush x:Key="EnvUatFg" Color="#D0B4FF" />
    <SolidColorBrush x:Key="EnvProdBg" Color="#3A2E12" />
    <SolidColorBrush x:Key="EnvProdFg" Color="#F5CE86" />
    <SolidColorBrush x:Key="EnvCustomBg" Color="#232A34" />
    <SolidColorBrush x:Key="EnvCustomFg" Color="#A2ACBA" />
    <SolidColorBrush x:Key="StatusDropBorder" Color="#7A3A33" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="BodySize">14</sys:Double>
    <sys:Double x:Key="CodeSize">13</sys:Double>

    <Style x:Key="SmallCapsLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="PaneHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource Danger}" />
    </Style>

    <Style x:Key="StatusChip" TargetType="ToggleButton">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinWidth" Value="86" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
