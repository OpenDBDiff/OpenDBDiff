<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:OpenDBDiff.Wpf.Converters"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!--
      Semantic colours, taken from the WinForms front end so a schema difference looks the same in
      both. Only the meaning-carrying colours are defined here; everything else (window chrome,
      buttons, tabs) uses the system theme, so the app follows the user's Windows settings instead
      of imposing a palette.
    -->

    <!-- ObjectStatus colours, as painted by SchemaTreeView in the WinForms front end. -->
    <SolidColorBrush x:Key="Status.Create" Color="Lime" />
    <SolidColorBrush x:Key="Status.Create.Text" Color="Green" />
    <SolidColorBrush x:Key="Status.Alter" Color="Blue" />
    <SolidColorBrush x:Key="Status.Drop" Color="Red" />
    <SolidColorBrush x:Key="Status.AlterWhitespace" Color="DarkGoldenrod" />
    <SolidColorBrush x:Key="Status.Rebuild" Color="Purple" />
    <SolidColorBrush x:Key="Status.Mixed" Color="Plum" />
    <SolidColorBrush x:Key="Status.Original" Color="Black" />

    <!-- The white strip that holds the two database panels. -->
    <SolidColorBrush x:Key="DatabasePanel.Background" Color="White" />

    <!-- Diff line backgrounds, matching the Scintilla marker colours in the WinForms front end. -->
    <SolidColorBrush x:Key="Diff.Inserted" Color="LightGreen" />
    <SolidColorBrush x:Key="Diff.Deleted" Color="LightSalmon" />
    <SolidColorBrush x:Key="Diff.Modified.New" Color="LightCyan" />
    <SolidColorBrush x:Key="Diff.Modified.Old" Color="PeachPuff" />

    <FontFamily x:Key="MonospaceFont">Consolas</FontFamily>

    <!--
      The action buttons of the main window: icon above the caption, fixed 95x55 so the strip keeps
      the proportions of the WinForms FlowLayoutPanel.
    -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Width" Value="95" />
        <Setter Property="Height" Value="55" />
        <Setter Property="Margin" Value="2,0,2,4" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style x:Key="ActionButtonIcon" TargetType="Path">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ActionButtonCaption" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- Legend swatches: 32x20 with a single-pixel border, as in the WinForms legend. -->
    <Style x:Key="LegendSwatch" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="20" />
        <Setter Property="BorderBrush" Value="Black" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="LegendCaption" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,20,0" />
    </Style>

    <Style x:Key="MutedCaption" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
