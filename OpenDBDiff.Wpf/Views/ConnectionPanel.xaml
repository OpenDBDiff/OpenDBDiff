<UserControl x:Class="OpenDBDiff.Wpf.Views.ConnectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      One database panel. The fields and their order come from SqlServerConnectFront: server,
      database, authentication, credentials, and a test button whose result is reported inline
      rather than in a message box.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="105" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Caption}" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,0,6,4" />
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                  IsEditable="True"
                  Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding Servers}"
                  DropDownOpened="Server_DropDownOpened" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,0,6,4" />
        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                  IsEditable="True"
                  Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding Databases}"
                  DropDownOpened="Database_DropDownOpened" />

        <!-- Why the list is empty, when it is: an empty drop-down with no explanation reads as a
             server with no databases rather than as a failed read. -->
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DatabaseError}"
                   Foreground="Red" TextWrapping="Wrap" Margin="0,24,0,4"
                   Visibility="{Binding DatabaseError, Converter={StaticResource NullToVisibility}}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Authentication:" VerticalAlignment="Center" Margin="0,0,6,4" />
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                  SelectedIndex="{Binding AuthenticationIndex, Mode=TwoWay}">
            <ComboBoxItem Content="Windows Authentication" />
            <ComboBoxItem Content="SQL Server Authentication" />
        </ComboBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="User name:" VerticalAlignment="Center" Margin="0,0,6,4" />
        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,4"
                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsSqlAuthenticationEnabled}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,6,4" />
        <PasswordBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,4"
                     PasswordChanged="Password_PasswordChanged"
                     IsEnabled="{Binding IsSqlAuthenticationEnabled}" />

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
            <Button Command="{Binding TestCommand}" Padding="8,2" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ActionButtonIcon}" Width="14" Height="14"
                          Data="{StaticResource Icon.Test}" Margin="0,0,4,0" />
                    <TextBlock Text="Test connection" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding TestMessage}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="200" />
        </StackPanel>
    </Grid>
</UserControl>
