<UserControl x:Class="OpenDBDiff.Wpf.Views.ActionBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Region F: the action bar (section 6.7). -->
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0"
            Padding="14,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Section 6.7: the selection count. Section 6.2 replaces it with "Comparing…" and makes the
                 list read-only while a comparison is running. -->
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"
                       Text="{Binding Results.SelectionText}"
                       Visibility="{Binding IsComparing, Converter={StaticResource InverseBoolToVisibility}}" />

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"
                       Foreground="{StaticResource TextMuted}"
                       Text="Comparing&#x2026;"
                       Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisibility}}" />

            <!-- Section 6.7: the destructive count is also the control that narrows the list to those
                 objects, which is why it is a button rather than a label. -->
            <Button Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"
                    Foreground="{StaticResource Danger}"
                    Content="{Binding Results.DestructiveText}"
                    ToolTip="{Binding Results.DestructiveTooltip}"
                    Command="{Binding ToggleDestructiveFilterCommand}"
                    Background="Transparent" BorderThickness="0" Padding="2,0" Cursor="Hand"
                    Visibility="{Binding Results.HasDestructive, Converter={StaticResource BoolToVisibility}}" />

            <!-- Section 9.4: the blocked state says how many problems stand in the way and fixes them
                 all in one step, so the user is not left hunting the list for the flagged rows. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                        Visibility="{Binding HasBlockingWarnings, Converter={StaticResource BoolToVisibility}}">
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource WarningFg}" FontWeight="SemiBold"
                           Text="{Binding DependencySummary}" Margin="0,0,10,0" />
                <Button Style="{StaticResource SecondaryButton}" Padding="12,4" MinHeight="30"
                        Content="{Binding FixAllLabel}" Command="{Binding FixAllCommand}"
                        ToolTip="Select everything the blocking warnings need, in one step" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <!-- Section 6.9: while the report is up, the action bar offers the report's own actions
                     rather than starting another run. -->
                <Button Style="{StaticResource SecondaryButton}" Content="Back to results" Margin="0,0,8,0"
                        Command="{Binding BackToResultsCommand}"
                        Visibility="{Binding IsReport, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsReport, Converter={StaticResource InverseBoolToVisibility}}">
                    <Button Style="{StaticResource SecondaryButton}" Content="Preview script" Margin="0,0,8,0"
                            Command="{Binding PreviewScriptCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Copy script" Margin="0,0,8,0"
                            Command="{Binding CopyScriptCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Save as&#x2026;" Margin="0,0,8,0"
                            Command="{Binding SaveScriptAsCommand}" />
                    <Button x:Name="ApplyButton"
                            Command="{Binding ApplyCommand}" MinWidth="260"
                            ToolTip="{Binding ApplyTooltip}"
                            Content="{Binding ApplyLabel}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Results.HasDestructive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasBlockingWarnings}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BorderStrong}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
