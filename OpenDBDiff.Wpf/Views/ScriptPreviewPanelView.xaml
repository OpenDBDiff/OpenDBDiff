<UserControl x:Class="OpenDBDiff.Wpf.Views.ScriptPreviewPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Section 6.7.1: a non-modal panel that slides over the detail pane, not a separate window. The
         data context is the main view model, because the actions beside the script belong to the shell. -->
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" />
        </Border.Effect>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="Copy" Margin="0,0,8,0"
                            Command="{Binding CopyScriptCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Save as&#x2026;" Margin="0,0,8,0"
                            Command="{Binding SaveScriptAsCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Close"
                            Command="{Binding CloseScriptPreviewCommand}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Style="{StaticResource PaneHeading}" Text="{Binding ScriptPreview.Title}" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding ScriptPreview.Summary}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- The destructive summary sits above the script rather than inside it, so it is read before
                 the text is scanned. -->
            <TextBlock Grid.Row="1" Foreground="{StaticResource Danger}" FontWeight="SemiBold" Margin="0,0,0,8"
                       Text="This script contains destructive statements"
                       Visibility="{Binding ScriptPreview.HasDestructive, Converter={StaticResource BoolToVisibility}}" />

            <Border Grid.Row="2" Background="{StaticResource WarningBg}" CornerRadius="6" Padding="10,6"
                    Margin="0,0,0,8"
                    Visibility="{Binding ScriptPreview.IsStale, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ScriptPreview.RibbonText}" Foreground="{StaticResource WarningFg}"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <TextBox Grid.Row="3" Text="{Binding ScriptPreview.Script, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="{StaticResource CodeFont}" FontSize="13" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="{StaticResource Surface}" BorderThickness="1"
                     BorderBrush="{StaticResource BorderSubtle}"
                     AutomationProperties.Name="Script for the selected changes" />
        </Grid>
    </Border>
</UserControl>
