<UserControl x:Class="OpenDBDiff.Wpf.Views.ConnectionStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OpenDBDiff.Wpf.Views">
    <!--
      Region A: the connection strip (section 6.1). Left to right: the app name, the source chip, swap,
      the destination chip, Edit, the Recent comparisons menu, a spacer, then the Schema/Data mode
      switch, Options and Compare.

      Section 6.1.6 puts the Recent comparisons menu "between Edit and the spacer", which is where it is.
    -->
    <Border Style="{StaticResource StripBar}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Item 1: the app name. Not interactive. -->
            <TextBlock Grid.Column="0" Style="{StaticResource AppNameLabel}" Text="OpenDBDiff" Margin="0,0,16,0" />

            <!-- Item 2: the source chip (6.1.2). -->
            <views:ConnectionChipView Grid.Column="1" DataContext="{Binding Source}"
                                      OpenCommand="{Binding DataContext.OpenPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ConnectionStripView}}}" />

            <!-- Item 3: swap, 40 x 36, marks the results stale. -->
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="8,0"
                    Command="{Binding SwapCommand}"
                    ToolTip="{Binding SwapTooltip}"
                    AutomationProperties.Name="Swap source and destination">
                <Path Style="{StaticResource ActionButtonIcon}" Width="16" Height="16"
                      Data="{StaticResource Icon.Swap}" />
            </Button>

            <!-- Item 4: the destination chip, which is the one an apply changes. -->
            <views:ConnectionChipView Grid.Column="3" DataContext="{Binding Destination}"
                                      OpenCommand="{Binding DataContext.OpenPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ConnectionStripView}}}" />

            <!-- Item 5: Edit opens the panel as a popover below the strip. -->
            <Button Grid.Column="4" Style="{StaticResource TextLinkButton}" Margin="12,0,0,0"
                    Content="Edit" Command="{Binding EditConnectionsCommand}"
                    ToolTip="Edit the connections" VerticalAlignment="Center" />

            <!-- Item 5b: the Recent comparisons menu (6.1.6), a clock icon between Edit and the spacer. -->
            <ToggleButton x:Name="RecentToggle" Grid.Column="5" Style="{StaticResource IconToggleButton}"
                          Margin="12,0,0,0" ToolTip="Recent comparisons"
                          AutomationProperties.Name="Recent comparisons">
                <Path Style="{StaticResource ActionButtonIcon}" Width="16" Height="16"
                      Data="{StaticResource Icon.Recent}" />
            </ToggleButton>

            <Popup IsOpen="{Binding IsChecked, ElementName=RecentToggle}" StaysOpen="False"
                   Placement="Bottom" PlacementTarget="{Binding ElementName=RecentToggle}"
                   AllowsTransparency="True">
                <Border Style="{StaticResource PanelPopover}" MinWidth="360" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SmallCapsLabel}" Text="RECENT COMPARISONS" Margin="8,4,8,6" />

                        <ItemsControl ItemsSource="{Binding RecentPairs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PopoverItemButton}" Command="{Binding OpenCommand}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Detail}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource MutedText}" Margin="8,4"
                                   Text="No recent comparisons yet."
                                   Visibility="{Binding HasRecentPairs, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Item 7: the Schema / Data mode switch (6.1.5). Data is enabled once the schema compare
                 found a table on both sides; the tooltip says what to do until then. -->
            <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="CompareMode" Content="Schema"
                             IsChecked="{Binding IsSchemaMode, Mode=OneWay}"
                             Command="{Binding ModeSchemaCommand}"
                             ToolTip="Compare schema objects" />
                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="CompareMode" Content="Data"
                             Margin="4,0,0,0"
                             IsChecked="{Binding IsDataMode, Mode=OneWay}"
                             IsEnabled="{Binding IsDataModeEnabled}"
                             Command="{Binding ModeDataCommand}"
                             ToolTip="{Binding DataModeTooltip}" />
            </StackPanel>

            <!-- Item 8: Options. -->
            <Button Grid.Column="8" Style="{StaticResource IconButton}" Command="{Binding OptionsCommand}"
                    ToolTip="Options" AutomationProperties.Name="Options">
                <Path Style="{StaticResource ActionButtonIcon}" Width="16" Height="16"
                      Data="{StaticResource Icon.Options}" />
            </Button>

            <!-- Item 9: Compare. The same slot shows Cancel while a comparison is running (6.2). -->
            <Grid Grid.Column="9" Margin="12,0,0,0">
                <Button Style="{StaticResource PrimaryButton}" MinWidth="150"
                        Command="{Binding CompareCommand}"
                        Content="{Binding CompareLabel}"
                        ToolTip="{Binding CompareTooltip}"
                        Visibility="{Binding IsComparing, Converter={StaticResource InverseBoolToVisibility}}" />

                <Button Style="{StaticResource SecondaryButton}" MinWidth="150"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        ToolTip="Stop the comparison (Esc)"
                        Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
