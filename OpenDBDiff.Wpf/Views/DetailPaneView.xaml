<UserControl x:Class="OpenDBDiff.Wpf.Views.DetailPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OpenDBDiff.Wpf.Converters">
    <UserControl.Resources>
        <converters:StatusBrushConverter x:Key="StatusBrush" />
        <converters:StatusBadgeConverter x:Key="StatusBadge" />
        <converters:DiffLineBrushConverter x:Key="DiffLineBrush" />
    </UserControl.Resources>

    <!-- Region E: the detail pane, diff first (section 6.5). -->
    <Grid Background="{StaticResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 6.5.1: object name, badge, plain-language summary, mode switch. -->
        <Grid Grid.Row="0" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatusBadge}" Margin="0,0,10,0"
                    Background="{Binding Results.DetailStatus, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                    BorderBrush="{Binding Results.DetailStatus, Converter={StaticResource StatusBrush}, ConverterParameter=border}"
                    BorderThickness="1">
                <TextBlock Style="{StaticResource StatusBadgeText}"
                           Text="{Binding Results.DetailStatus, Converter={StaticResource StatusBadge}}"
                           Foreground="{Binding Results.DetailStatus, Converter={StaticResource StatusBrush}, ConverterParameter=fg}" />
            </Border>

            <TextBlock Grid.Column="1" Style="{StaticResource PaneHeading}" Text="{Binding Results.DetailTitle}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />

            <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" Text="{Binding Results.DetailSummary}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <RadioButton Content="Side by side" Margin="0,0,10,0" VerticalAlignment="Center"
                             GroupName="DetailMode" IsChecked="{Binding Results.IsSideBySide, Mode=OneWay}"
                             Command="{Binding ShowSideBySideCommand}" />
                <RadioButton Content="Inline" Margin="0,0,10,0" VerticalAlignment="Center"
                             GroupName="DetailMode" IsChecked="{Binding Results.IsInline, Mode=OneWay}"
                             Command="{Binding ShowInlineCommand}" />
                <RadioButton Content="Script" VerticalAlignment="Center"
                             GroupName="DetailMode" IsChecked="{Binding Results.IsScript, Mode=OneWay}"
                             Command="{Binding ShowScriptCommand}" />
            </StackPanel>
        </Grid>

        <!-- 6.5.2: column headers, naming which side is which. -->
        <Grid Grid.Row="1" Height="32" Background="{StaticResource SurfaceAlt}"
              Visibility="{Binding Results.IsSideBySide, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource SmallCapsLabel}" Margin="46,0,0,0" VerticalAlignment="Center"
                       Text="{Binding SourceColumnHeader}" />
            <TextBlock Grid.Column="1" Style="{StaticResource SmallCapsLabel}" Margin="46,0,0,0" VerticalAlignment="Center"
                       Text="{Binding DestinationColumnHeader}" />
        </Grid>

        <Grid Grid.Row="2">
            <!-- Side by side: aligned rows, so both sides share one scroll position. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Results.IsSideBySide, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Results.SideBySideRows}" FontFamily="{StaticResource CodeFont}" FontSize="13">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding LeftLineNumber}" TextAlignment="Right"
                                           Foreground="{StaticResource TextFaint}" Margin="0,0,8,0"
                                           Background="{Binding LeftKind, Converter={StaticResource DiffLineBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Left}" TextWrapping="NoWrap"
                                           Background="{Binding LeftKind, Converter={StaticResource DiffLineBrush}}" />
                                <TextBlock Grid.Column="2" Text="{Binding RightLineNumber}" TextAlignment="Right"
                                           Foreground="{StaticResource TextFaint}" Margin="0,0,8,0"
                                           Background="{Binding RightKind, Converter={StaticResource DiffLineBrush}}" />
                                <TextBlock Grid.Column="3" Text="{Binding Right}" TextWrapping="NoWrap"
                                           Background="{Binding RightKind, Converter={StaticResource DiffLineBrush}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Inline: one column, unified. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Results.IsInline, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Results.InlineRows}" FontFamily="{StaticResource CodeFont}" FontSize="13">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" Height="24" TextWrapping="NoWrap"
                                       Background="{Binding Kind, Converter={StaticResource DiffLineBrush}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Script: exactly what would run for this object (section 6.5.2). -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Results.IsScript, Converter={StaticResource BoolToVisibility}}">
                <TextBox Text="{Binding Results.ScriptText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         FontFamily="{StaticResource CodeFont}" FontSize="13" TextWrapping="NoWrap"
                         Background="{StaticResource Surface}" />
            </ScrollViewer>

            <!-- Nothing focused yet: say how big the difference is before showing any of it. -->
            <Border Background="{StaticResource Surface}" Padding="20"
                    Visibility="{Binding Results.HasFocusedItem, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PaneHeading}" Text="{Binding PreSelectionHeading}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="{Binding PreSelectionHint}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
