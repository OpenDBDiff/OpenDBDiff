<UserControl x:Class="OpenDBDiff.Wpf.Views.ConnectionChipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OpenDBDiff.Wpf.Views">
    <!--
      One connection chip (section 6.1.2). The whole chip is a button that opens the Connection Panel
      focused on this side, so the host supplies the command and the data context is a
      ConnectionViewModel.
    -->
    <Button Style="{StaticResource ChipButton}"
            Command="{Binding OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ConnectionChipView}}}"
            CommandParameter="{Binding}"
            AutomationProperties.Name="{Binding SideLabel, StringFormat={}{0} connection}">
        <Button.ToolTip>
            <TextBlock>
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}&#x0a;{1}">
                        <Binding Path="ChipTooltip" />
                        <Binding Path="StatusTooltip" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Button.ToolTip>

        <StackPanel Orientation="Horizontal">
            <!-- The state is in the tooltip as well as the colour (section 2, principle 7). While a test
                 is running the dot pulses (section 6.1.2). -->
            <Ellipse Fill="{Binding Validity, Converter={StaticResource ValidityDot}}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse" BasedOn="{StaticResource ChipDot}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="TestingPulse">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.3" Duration="0:0:0.6" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="TestingPulse" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <TextBlock Style="{StaticResource ChipServerText}" Text="{Binding ServerDisplay}" MaxWidth="220" />
            <TextBlock Style="{StaticResource ChipDatabaseText}" Text="{Binding DatabaseDisplay}" MaxWidth="200" />

            <!-- Section 6.1.4: the tag sits inside the chip. -->
            <Border Style="{StaticResource EnvTagBorder}"
                    Background="{Binding EnvironmentBackground, Converter={StaticResource HexBrush}}"
                    Visibility="{Binding HasEnvironmentTag, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{Binding EnvironmentText, StringFormat=Environment: {0}}">
                <TextBlock Style="{StaticResource EnvTagText}"
                           Text="{Binding EnvironmentText}"
                           Foreground="{Binding EnvironmentForeground, Converter={StaticResource HexBrush}}" />
            </Border>
        </StackPanel>
    </Button>
</UserControl>
