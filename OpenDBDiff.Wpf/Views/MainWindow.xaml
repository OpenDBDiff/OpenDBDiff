<Window x:Class="OpenDBDiff.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpenDBDiff.Wpf.Views"
        Title="OpenDBDiff"
        Icon="App.ico"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">

    <Window.InputBindings>
        <!-- Section 7.2. Ctrl+F, Esc and F1 need the code-behind because they move focus or depend on
             what is on screen; everything else is a command. -->
        <KeyBinding Key="F5" Command="{Binding CompareCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding PreviewScriptCommand}" />
        <KeyBinding Key="C" Modifiers="Control,Shift" Command="{Binding CopyScriptCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveScriptAsCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control,Shift" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding EditConnectionsCommand}" />
        <KeyBinding Key="X" Modifiers="Control,Shift" Command="{Binding SwapCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowSideBySideCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowInlineCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowScriptCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Section 12: the menu bar, which is where every legacy capability now lives. At narrow
             widths the same Menu instance moves into the menu button's popup (see the code-behind). -->
        <Grid Grid.Row="0" Background="{StaticResource Surface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="MenuHost" Grid.Column="0" VerticalAlignment="Center">
                <Menu x:Name="MainMenu" VerticalAlignment="Center">

            <ToggleButton x:Name="MenuButton" Grid.Column="0" Style="{StaticResource IconToggleButton}"
                          Margin="4,4" HorizontalAlignment="Left"
                          Visibility="{Binding IsNarrow, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="Menu" AutomationProperties.Name="Menu">
                <Path Style="{StaticResource ActionButtonIcon}" Width="16" Height="16"
                      Data="{StaticResource Icon.Menu}" />
            </ToggleButton>

            <Popup x:Name="MenuPopup" IsOpen="{Binding IsChecked, ElementName=MenuButton}" StaysOpen="False"
                   Placement="Bottom" PlacementTarget="{Binding ElementName=MenuButton}" AllowsTransparency="True" />


                <MenuItem Header="_File">
                    <MenuItem Header="New project" Command="{Binding NewProjectCommand}" />
                    <MenuItem Header="Open project&#x2026;" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O" />
                    <MenuItem Header="Save project" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+Shift+S" />
                    <MenuItem Header="Save project as&#x2026;" Command="{Binding SaveProjectAsCommand}" />
                    <MenuItem Header="Recent projects" ItemsSource="{Binding RecentProjects}"
                              IsEnabled="{Binding HasRecentProjects}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Path}" />
                                <Setter Property="Command" Value="{Binding OpenCommand}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
                </MenuItem>

                <MenuItem Header="_Compare">
                    <MenuItem Header="Compare" Command="{Binding CompareCommand}" InputGestureText="F5" />
                    <MenuItem Header="Cancel" Command="{Binding CancelCommand}" InputGestureText="Esc" />
                    <MenuItem Header="Swap source and destination" Command="{Binding SwapCommand}" InputGestureText="Ctrl+Shift+X" />
                    <Separator />
                    <MenuItem Header="Schema" Command="{Binding ModeSchemaCommand}" IsCheckable="True" IsChecked="{Binding IsSchemaMode, Mode=OneWay}" />
                    <MenuItem Header="Data" Command="{Binding ModeDataCommand}" IsCheckable="True" IsChecked="{Binding IsDataMode, Mode=OneWay}" IsEnabled="{Binding IsDataModeEnabled}" ToolTip="{Binding DataModeTooltip}" />
                    <Separator />
                    <MenuItem Header="Recent comparisons" ItemsSource="{Binding RecentPairs}"
                              IsEnabled="{Binding HasRecentPairs}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Header}" />
                                <Setter Property="Command" Value="{Binding OpenCommand}" />
                                <Setter Property="ToolTip" Value="{Binding Detail}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="_View">
                    <MenuItem Header="Show identical objects" Command="{Binding ToggleShowIdenticalCommand}" IsCheckable="True" IsChecked="{Binding IsIdenticalShown, Mode=OneWay}" />
                    <Separator />
                    <MenuItem Header="Group by type" Command="{Binding ShowGroupedCommand}" IsCheckable="True" IsChecked="{Binding IsGroupedView, Mode=OneWay}" />
                    <MenuItem Header="Flat list" Command="{Binding ShowFlatCommand}" IsCheckable="True" IsChecked="{Binding IsFlatView, Mode=OneWay}" />
                    <Separator />
                    <MenuItem Header="Detail mode">
                        <MenuItem Header="Side by side" Command="{Binding ShowSideBySideCommand}" IsCheckable="True" IsChecked="{Binding IsSideBySideDetail, Mode=OneWay}" InputGestureText="Ctrl+1" />
                        <MenuItem Header="Inline" Command="{Binding ShowInlineCommand}" IsCheckable="True" IsChecked="{Binding IsInlineDetail, Mode=OneWay}" InputGestureText="Ctrl+2" />
                        <MenuItem Header="Script" Command="{Binding ShowScriptCommand}" IsCheckable="True" IsChecked="{Binding IsScriptDetail, Mode=OneWay}" InputGestureText="Ctrl+3" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Reset layout" Command="{Binding ResetLayoutCommand}" />
                    <MenuItem Header="Theme">
                        <MenuItem Header="Light" Command="{Binding ThemeCommand}" CommandParameter="Light" />
                        <MenuItem Header="Dark" Command="{Binding ThemeCommand}" CommandParameter="Dark" />
                        <MenuItem Header="System" Command="{Binding ThemeCommand}" CommandParameter="System" />
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="_Script">
                    <MenuItem Header="Preview" Command="{Binding PreviewScriptCommand}" InputGestureText="Ctrl+Enter" />
                    <MenuItem Header="Copy" Command="{Binding CopyScriptCommand}" InputGestureText="Ctrl+Shift+C" />
                    <MenuItem Header="Save as&#x2026;" Command="{Binding SaveScriptAsCommand}" InputGestureText="Ctrl+S" />
                </MenuItem>

                <MenuItem Header="_Tools">
                    <MenuItem Header="Options&#x2026;" Command="{Binding OptionsCommand}" />
                    <MenuItem Header="Open reports folder" Command="{Binding OpenReportsFolderCommand}" />
                </MenuItem>

                <MenuItem Header="_Help">
                    <MenuItem Header="Keyboard shortcuts" Command="{Binding ShowShortcutsCommand}" InputGestureText="F1" />
                    <MenuItem Header="Documentation" Command="{Binding OpenDocumentationCommand}" />
                    <MenuItem Header="About" Command="{Binding AboutCommand}" />
                </MenuItem>
                </Menu>
            </Border>
        </Grid>

        <!-- Region A: the connection strip. -->
        <views:ConnectionStripView Grid.Row="1" DataContext="{Binding}" />

        <!-- Section 6.1.1: the connection panel, inline in SETUP and below the strip otherwise. -->
        <views:ConnectionPanelHostView Grid.Row="2" DataContext="{Binding}" />

        <!-- Region B: the 3 px progress track. Its height is reserved whether or not a run is active,
             so nothing shifts when one starts (section 6.2). -->
        <Grid Grid.Row="3" Background="{StaticResource BorderSubtle}">
            <ProgressBar Style="{StaticResource StripProgressBar}"
                         Visibility="{Binding IsProgressActive, Converter={StaticResource BoolToVisibility}}"
                         Value="{Binding Progress.FillPercent}"
                         IsIndeterminate="{Binding Progress.IsIndeterminate}"
                         ToolTip="{Binding Progress.PerSideTooltip}" />
        </Grid>

        <!-- Region C: the summary bar, with the progress status text and Cancel on its right (6.2). -->
        <views:SummaryBarView x:Name="SummaryBar" Grid.Row="4" DataContext="{Binding}" />

        <!-- Section 9.6: the stale banner sits under the Summary Bar. -->
        <Border Grid.Row="5" Style="{StaticResource StaleBanner}"
                Visibility="{Binding IsStaleBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding CompareAgainCommand}"
                            Padding="12,4" MinHeight="30">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ActionButtonIcon}" Width="14" Height="14"
                                  Data="{StaticResource Icon.Refresh}" Margin="0,0,6,0" />
                            <TextBlock Text="Compare again" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Style="{StaticResource StaleBannerText}" Text="{Binding StaleBannerText}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="{Binding StaleReasonText}" />
            </DockPanel>
        </Border>

        <!-- Regions D and E, with the splitter of section 6.6. -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ReviewListWidth, Mode=TwoWay}" MinWidth="280" MaxWidth="720" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Background="{StaticResource Surface}">
                <views:ReviewListView DataContext="{Binding}" />
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{StaticResource Bg}"
                          ToolTip="Drag to resize, double-click to reset" />

            <views:DetailPaneView Grid.Column="2" DataContext="{Binding}" />

            <!-- Section 6.10: toasts, bottom-centre above the action bar. -->
            <ItemsControl Grid.ColumnSpan="3" ItemsSource="{Binding Toasts}"
                          VerticalAlignment="Bottom" HorizontalAlignment="Center"
                          Margin="0,0,0,12" IsHitTestVisible="False" Panel.ZIndex="20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ToastBorder}">
                            <TextBlock Style="{StaticResource ToastText}" Text="{Binding Message}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Region F: the action bar. -->
        <views:ActionBarView Grid.Row="7" DataContext="{Binding}" />

        <Border Grid.Row="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Margin="14,6" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
