<Window x:Class="OpenDBDiff.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenDBDiff.Wpf.Controls"
        xmlns:views="clr-namespace:OpenDBDiff.Wpf.Views"
        xmlns:converters="clr-namespace:OpenDBDiff.Wpf.Converters"
        Title="{Binding Title}"
        Icon="App.ico"
        Width="940" Height="683" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:NodeColourToBrushConverter x:Key="NodeColourToBrush" />
        <converters:DiffLineToBrushConverter x:Key="DiffLineToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
          The tree: a checkbox on every object, the folder captions counting what they hold, and the
          colour coming from the object's status. Same information as the WinForms tree, as data.
        -->
        <HierarchicalDataTemplate x:Key="SchemaNodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          Visibility="{Binding IsCheckable, Converter={StaticResource BoolToVisibility}}"
                          VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding Text}" VerticalAlignment="Center"
                           Foreground="{Binding Colour, Converter={StaticResource NodeColourToBrush}}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top strip: the project buttons on the left, the two database panels either side of the swap button. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="126" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="4,4,4,0">
                <Button Style="{StaticResource ActionButton}" Command="{Binding OpenProjectCommand}" Margin="2,0,2,6">
                    <StackPanel>
                        <Path Style="{StaticResource ActionButtonIcon}" Data="{StaticResource Icon.OpenProject}" />
                        <TextBlock Style="{StaticResource ActionButtonCaption}" Text="Open project" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding NewProjectCommand}" Margin="2,0,2,6">
                    <StackPanel>
                        <Path Style="{StaticResource ActionButtonIcon}" Data="{StaticResource Icon.NewProject}" />
                        <TextBlock Style="{StaticResource ActionButtonCaption}" Text="New project" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding SaveProjectCommand}" Margin="2,0,2,6">
                    <StackPanel>
                        <Path Style="{StaticResource ActionButtonIcon}" Data="{StaticResource Icon.SaveProject}" />
                        <TextBlock Style="{StaticResource ActionButtonCaption}" Text="Save project" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource DatabasePanel.Background}" Padding="3" MinHeight="175">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Padding="6">
                        <views:ConnectionPanel DataContext="{Binding Source}" />
                    </Border>

                    <Button Grid.Column="1" Command="{Binding SwapCommand}" Margin="3,0"
                            ToolTip="Swap source and destination">
                        <Path Style="{StaticResource ActionButtonIcon}" Data="{StaticResource Icon.Swap}" Stretch="Fill" />
                    </Button>

                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Padding="6">
                        <views:ConnectionPanel DataContext="{Binding Destination}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Work area: the tabs, with the action strip down the right-hand side. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="98" />
            </Grid.ColumnDefinitions>

            <TabControl x:Name="WorkTabs" Grid.Column="0" SelectionChanged="WorkTabs_SelectionChanged">
                <TabItem Header="Schema">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding SplitterDistance, Mode=TwoWay}" MinWidth="150" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Objects" Padding="4">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                    <CheckBox Content="New" IsChecked="{Binding Tree.ShowNewItems, Mode=TwoWay}" />
                                    <CheckBox Content="Missing" IsChecked="{Binding Tree.ShowMissingItems, Mode=TwoWay}" />
                                    <CheckBox Content="Different" IsChecked="{Binding Tree.ShowChangedItems, Mode=TwoWay}" />
                                    <CheckBox Content="Unchanged" IsChecked="{Binding Tree.ShowUnchangedItems, Mode=TwoWay}" />
                                </StackPanel>
                                <TreeView x:Name="SchemaTree"
                                          ItemsSource="{Binding Tree.Nodes}"
                                          ItemTemplate="{StaticResource SchemaNodeTemplate}"
                                          SelectedItemChanged="SchemaTree_SelectedItemChanged" />
                            </DockPanel>
                        </GroupBox>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Legend: the three colours the WinForms legend documented. -->
                            <WrapPanel Grid.Row="0" Margin="2,4,2,6">
                                <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource Status.Create}" />
                                <TextBlock Style="{StaticResource LegendCaption}" Text="Create new object" />
                                <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource Status.Alter}" />
                                <TextBlock Style="{StaticResource LegendCaption}" Text="Alter old object" />
                                <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource Status.Drop}" />
                                <TextBlock Style="{StaticResource LegendCaption}" Text="Drop object" />
                            </WrapPanel>

                            <TabControl Grid.Row="1">
                                <TabItem Header="New object">
                                    <controls:SqlEditor Text="{Binding Diff.NewText, Mode=OneWay}" LexerName="sql" IsReadOnly="True" />
                                </TabItem>
                                <TabItem Header="Old object">
                                    <controls:SqlEditor Text="{Binding Diff.OldText, Mode=OneWay}" LexerName="sql" IsReadOnly="True" />
                                </TabItem>
                                <TabItem Header="Diff">
                                    <ListBox ItemsSource="{Binding Diff.Lines}"
                                             FontFamily="{StaticResource MonospaceFont}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             VirtualizingPanel.IsVirtualizing="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="2,0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}"
                                                           Background="{Binding Kind, Converter={StaticResource DiffLineToBrush}}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Synchronized script">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{x:Static SystemColors.ControlDarkBrush}" BorderThickness="1" Margin="4">
                            <controls:SqlEditor Text="{Binding SyncScript, Mode=OneWay}" LexerName="sql" IsReadOnly="True" />
                        </Border>

                        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="6,2,6,6" TextWrapping="Wrap" />
                    </Grid>
                </TabItem>

                <TabItem Header="Action report">
                    <TextBox Text="{Binding ActionReport, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="{StaticResource MonospaceFont}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Margin="4" />
                </TabItem>
            </TabControl>

            <!-- Action strip: icon above caption, in the order the WinForms FlowLayoutPanel used. -->
            <StackPanel Grid.Column="1" Margin="0,2,2,0">
                <Button Style="{StaticResource ActionButton}" Command="{Binding CompareCommand}">
                    <StackPanel>
                        <Path Style="{StaticResource ActionButtonIcon}" Data="{StaticResource Icon.Compare}" />
                        <TextBlock Style="{StaticResource ActionButtonCaption}" Text="Compare" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding OptionsCommand}">
                    <StackPanel>
                        <Path Style="{StaticResource ActionButtonIcon}" Data="{StaticResource Icon.Options}" />
                        <TextBlock Style="{StaticResource ActionButtonCaption}" Text="Options" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding SaveScriptAsCommand}">
                    <StackPanel>
                        <Path Style="{StaticResource ActionButtonIcon}" Data="{StaticResource Icon.SaveAs}" />
                        <TextBlock Style="{StaticResource ActionButtonCaption}" Text="Save as" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding CopyScriptCommand}">
                    <StackPanel>
                        <Path Style="{StaticResource ActionButtonIcon}" Data="{StaticResource Icon.Copy}" />
                        <TextBlock Style="{StaticResource ActionButtonCaption}" Text="Copy script" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding UpdateSelectedCommand}">
                    <StackPanel>
                        <Path Style="{StaticResource ActionButtonIcon}" Data="{StaticResource Icon.Update}" />
                        <TextBlock Style="{StaticResource ActionButtonCaption}" Text="Update selected" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding CompareDataCommand}">
                    <StackPanel>
                        <Path Style="{StaticResource ActionButtonIcon}" Data="{StaticResource Icon.CompareData}" />
                        <TextBlock Style="{StaticResource ActionButtonCaption}" Text="Compare data" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding UpdateAllCommand}">
                    <StackPanel>
                        <Path Style="{StaticResource ActionButtonIcon}" Data="{StaticResource Icon.UpdateAll}" />
                        <TextBlock Style="{StaticResource ActionButtonCaption}" Text="Update all" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
