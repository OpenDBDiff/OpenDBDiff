<Window x:Class="OpenDBDiff.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:OpenDBDiff.Wpf.Converters"
        xmlns:views="clr-namespace:OpenDBDiff.Wpf.Views"
        Title="OpenDBDiff"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.InputBindings>
        <!-- Section 7.2: the keys Phase 1 can honour. Ctrl+F is handled in the code-behind because it
             has to move focus to a particular control. -->
        <KeyBinding Key="F5" Command="{Binding CompareCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding OptionsCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowSideBySideCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowInlineCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowScriptCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Region A, in its Phase 1 form: the connection panels the previous layout used, with the
             compare action beside them. Phase 2 replaces this with the connection strip. -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,0,1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="8">
                    <views:ConnectionPanel DataContext="{Binding Source}" />
                </Border>

                <Button Grid.Column="1" Command="{Binding SwapCommand}" Margin="3,0"
                        ToolTip="Swap source and destination">
                    <Path Style="{StaticResource ActionButtonIcon}" Data="{StaticResource Icon.Swap}" Stretch="Fill" />
                </Button>

                <Border Grid.Column="2" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="8">
                    <views:ConnectionPanel DataContext="{Binding Destination}" />
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OptionsCommand}" Margin="0,0,8,0"
                            ToolTip="Options">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ActionButtonIcon}" Width="14" Height="14"
                                  Data="{StaticResource Icon.Options}" Margin="0,0,6,0" />
                            <TextBlock Text="Options" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CompareCommand}"
                            Content="Compare" MinWidth="120" ToolTip="Compare (F5)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Region C: the summary bar. -->
        <views:SummaryBarView x:Name="SummaryBar" Grid.Row="1" DataContext="{Binding}" />

        <!-- Region B: the progress track. Its 3px is reserved whether or not a comparison is running,
             so nothing shifts when one starts. Phase 2 fills it and streams the per-side status. -->
        <Border Grid.Row="2" Background="{StaticResource BorderSubtle}" />

        <!-- Regions D and E, with the splitter of section 6.6. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ReviewListWidth, Mode=TwoWay}" MinWidth="280" MaxWidth="720" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Background="{StaticResource Surface}">
                <views:ReviewListView DataContext="{Binding}" />
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{StaticResource Bg}"
                          ToolTip="Drag to resize, double-click to reset" />

            <views:DetailPaneView Grid.Column="2" DataContext="{Binding}" />
        </Grid>

        <!-- Region F: the action bar. -->
        <views:ActionBarView Grid.Row="4" DataContext="{Binding}" />

        <Border Grid.Row="5" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Margin="14,6" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
