<UserControl x:Class="OpenDBDiff.Wpf.Views.ReviewListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OpenDBDiff.Wpf.Converters"
             xmlns:views="clr-namespace:OpenDBDiff.Wpf.Views"
             xmlns:vm="clr-namespace:OpenDBDiff.Wpf.ViewModels">
    <UserControl.Resources>
        <converters:StatusBrushConverter x:Key="StatusBrush" />
        <converters:StatusBadgeConverter x:Key="StatusBadge" />

        <!-- Section 6.4.2: the group header. -->
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type vm:ResultsRowViewModel}">
            <Border Background="{StaticResource SurfaceAlt}" Height="40" Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ToggleButton Grid.Column="0" Width="18" Height="18" Margin="0,0,6,0"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                  Background="Transparent" BorderThickness="0"
                                  Content="{Binding IsExpanded, Converter={StaticResource ExpandedGlyph}}" />

                    <CheckBox Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"
                              IsThreeState="True"
                              IsChecked="{Binding CheckBoxState, Mode=TwoWay}"
                              ToolTip="Include or exclude everything in this group that is visible" />

                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="Bold" FontSize="13"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="3" Text="{Binding CountText}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Section 6.4.3: the item row. -->
        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type vm:ResultsRowViewModel}">
            <Border Height="38" Padding="8,0" Background="{Binding IsSelected, Converter={StaticResource SelectionBrush}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                              IsChecked="{Binding CheckBoxState, Mode=TwoWay}"
                              IsEnabled="{Binding CanToggle}"
                              ToolTip="{Binding UnsupportedReason}" />

                    <Border Grid.Column="1" Style="{StaticResource StatusBadge}" Margin="0,0,10,0"
                            Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                            BorderBrush="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=border}"
                            BorderThickness="1">
                        <TextBlock Style="{StaticResource StatusBadgeText}"
                                   Text="{Binding Status, Converter={StaticResource StatusBadge}}"
                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}" />
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}" />

                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="{StaticResource WarningFg}" FontWeight="Bold"
                               Text="!" Visibility="{Binding IsWarning, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="This object has a dependency warning" />
                </Grid>
            </Border>
        </DataTemplate>

        <views:ResultsRowTemplateSelector x:Key="RowSelector"
                                          GroupTemplate="{StaticResource GroupTemplate}"
                                          ItemTemplate="{StaticResource ItemTemplate}" />
    </UserControl.Resources>

    <!-- Region D: the review list (section 6.4). -->
    <Grid Background="{StaticResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="41" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                          IsThreeState="True"
                          IsChecked="{Binding Results.SelectAllState, Mode=TwoWay}"
                          Content="All changed"
                          ToolTip="Include or exclude every visible difference" />

                <ComboBox Grid.Column="1" Width="130" VerticalAlignment="Center"
                          SelectedIndex="{Binding Results.IsGrouped, Converter={StaticResource GroupedIndex}}">
                    <ComboBoxItem Content="Grouped" />
                    <ComboBoxItem Content="Flat list" />
                </ComboBox>
            </Grid>
        </Border>

        <ListBox x:Name="Rows"
                 Grid.Row="1"
                 ItemsSource="{Binding Results.Rows}"
                 SelectedItem="{Binding Results.SelectedRow, Mode=TwoWay}"
                 ItemTemplateSelector="{StaticResource RowSelector}"
                 BorderThickness="0" Background="{StaticResource Surface}"
                 IsEnabled="{Binding IsNotComparing}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <TextBlock Grid.Row="2" Text="{Binding Results.FooterText}" Margin="10,6,10,6"
                   Foreground="{StaticResource TextMuted}"
                   Visibility="{Binding Results.HasFooter, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
