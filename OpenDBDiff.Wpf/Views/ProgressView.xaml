<UserControl x:Class="OpenDBDiff.Wpf.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      The comparison window: one bar per database being read, each captioned with the database it is
      reading, exactly the two progress controls the WinForms ProgressForm showed.
    -->
    <StackPanel Margin="14" MinWidth="420">
        <TextBlock Text="Compare Progress" FontWeight="Bold" Margin="0,0,0,10" />

        <TextBlock Text="{Binding Origin.Caption}" Margin="0,0,0,2" />
        <ProgressBar Height="18" Minimum="0" Maximum="{Binding Origin.Maximum}" Value="{Binding Origin.Value}" />
        <TextBlock Text="{Binding Origin.Message}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis" />

        <TextBlock Text="{Binding Destination.Caption}" Margin="0,0,0,2" />
        <ProgressBar Height="18" Minimum="0" Maximum="{Binding Destination.Maximum}" Value="{Binding Destination.Value}" />
        <TextBlock Text="{Binding Destination.Message}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />

        <Button Content="OK" Width="80" HorizontalAlignment="Right" Padding="6,3"
                IsEnabled="{Binding CanClose}" Click="Ok_Click" />
    </StackPanel>
</UserControl>
